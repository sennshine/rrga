import pandas as pd
import requests

def fetch_weather_data(location_name, latitude, longitude, start_date, end_date):
    # Construct the API request URL (fetching hourly weather data)
    api_url = f"https://archive-api.open-meteo.com/v1/archive?latitude={latitude}&longitude={longitude}&start_date={start_date}&end_date={end_date}&hourly=temperature_2m,precipitation,wind_speed_10m,wind_direction_10m,relative_humidity_2m,surface_pressure,weather_code"

    # Weather code mapping for weather description
    weather_descriptions = {
        0: "Clear sky", 1: "Mainly clear", 2: "Partly cloudy", 3: "Overcast",
        45: "Fog", 48: "Depositing rime fog", 51: "Light drizzle", 53: "Moderate drizzle", 55: "Dense drizzle",
        56: "Light freezing drizzle", 57: "Dense freezing drizzle", 61: "Slight rain", 63: "Moderate rain",
        65: "Heavy rain", 66: "Light freezing rain", 67: "Heavy freezing rain", 71: "Slight snow fall",
        73: "Moderate snow fall", 75: "Heavy snow fall", 77: "Snow grains", 80: "Slight rain showers",
        81: "Moderate rain showers", 82: "Violent rain showers", 85: "Slight snow showers", 86: "Heavy snow showers",
        95: "Thunderstorm", 96: "Thunderstorm with slight hail", 99: "Thunderstorm with heavy hail"
    }

    # Fetch data from the API
    response = requests.get(api_url)
    data = response.json()

    # Extract hourly weather data
    hourly_data = data.get("hourly", {})

    # Convert hourly data to DataFrame
    df_hourly = pd.DataFrame(hourly_data)
    df_hourly['time'] = pd.to_datetime(df_hourly['time'])

    # Rename columns for clarity
    df_hourly.rename(columns={
        'precipitation': 'rainfall_precipitation_mm_per_hour',
        'temperature_2m': 'temperature_2m',
        'surface_pressure': 'atmospheric_pressure_hpa',
        'relative_humidity_2m': 'humidity_percent',
        'wind_speed_10m': 'wind_speed_m_s',
        'wind_direction_10m': 'wind_direction_degrees'
    }, inplace=True)

    # Add weather description based on weather code
    df_hourly['weather_description'] = df_hourly['weather_code'].map(weather_descriptions)

    # Drop the 'weather_code' column as it's no longer needed
    df_hourly.drop(columns=['weather_code'], inplace=True)

    # Calculate hourly rainfall accumulation (cumulative sum of rainfall)
    df_hourly['rainfall_accumulation_mm'] = df_hourly['rainfall_precipitation_mm_per_hour'].cumsum()

    return df_hourly

# Define locations
locations = {
    "Beaufort": (5.3473, 115.7455),
    "Keningau": (5.3373, 116.1606),
    "Tenom": (5.1212, 115.9427)
}

start_date = "2025-03-08"
end_date = "2025-03-11"

# Create an Excel file with separate sheets for each location
with pd.ExcelWriter("Sabah_Weather_March_8-11_2025.xlsx") as writer:
    for location, (lat, lon) in locations.items():
        df_hourly = fetch_weather_data(location, lat, lon, start_date, end_date)
        df_hourly.to_excel(writer, sheet_name=f"{location} Hourly", index=False)

print("Hourly weather data saved to 'Sabah_Weather_March_8-11_2025.xlsx'")
